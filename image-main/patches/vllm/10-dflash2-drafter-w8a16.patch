             self.lm_head, hidden_states, self.model.candidate_selector.top_k
         )
 
+    def load_weights(self, weights):
+        # Optional 8-bit drafter weights (patch 10): convert after the stock loader,
+        # which has already built the BF16 fused context K/V copy. Off unless
+        # VLLM_DRAFTER_W8A16=1.
+        loaded = super().load_weights(weights)
+        from vllm.distributed import get_tensor_model_parallel_world_size
+        from vllm.model_executor.models.drafter_w8a16 import finalize_drafter_w8a16
+
+        finalize_drafter_w8a16(self.model, get_tensor_model_parallel_world_size())
+        return loaded
+
 
 EntryClass = DFlash2Qwen3ForCausalLM
